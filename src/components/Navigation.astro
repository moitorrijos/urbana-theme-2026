---
interface Props {
  currentPage?: string;
  /** Render the header on top of the page content (used by the home hero). */
  overlay?: boolean;
}

const { currentPage = "home", overlay = false } = Astro.props;

const navLinks = [
  {
    href: "/",
    label: "HOME",
    id: "home",
    icon: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  },
  {
    href: "/rooms",
    label: "ROOMS",
    id: "rooms",
    icon: '<path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M2 17h20"/><path d="M6 10V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4"/>',
  },
  {
    href: "/amenities",
    label: "AMENITIES",
    id: "amenities",
    icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  },
  {
    href: "/contact",
    label: "CONTACT",
    id: "contact",
    icon: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
];
---

<header
  class:list={[
    "w-full z-50",
    overlay ? "absolute inset-x-0 top-0" : "relative",
  ]}
>
  <!-- Top Bar -->
  <div class="bg-top-bar text-white h-11 flex items-center">
    <div
      class="container mx-auto px-4 flex items-center justify-between gap-6 font-body text-xs md:text-[13px]"
    >
      <p class="hidden sm:flex items-center gap-2">
        <svg
          class="w-4 h-4 shrink-0 text-white/70"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        SOHO 555, Broadway, New York, NY
      </p>

      <div class="flex items-center gap-5 md:gap-10 ml-auto">
        <a
          href="tel:+12122204519"
          class="flex items-center gap-2 hover:text-sky-blue-light transition-colors"
        >
          <svg
            class="w-4 h-4 shrink-0 text-white/70"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92"
            ></path>
          </svg>
          +212-220-4519
        </a>
        <a
          href="mailto:info@urbana.com"
          class="flex items-center gap-2 italic hover:text-sky-blue-light transition-colors"
        >
          <svg
            class="w-4 h-4 shrink-0 not-italic text-white/70"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          info@urbana.com
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <nav class={overlay ? "bg-[#3C464B]/55 backdrop-blur-[2px]" : "bg-navbar"}>
    <div
      class="container mx-auto px-4 h-16 md:h-20 flex items-center justify-center md:justify-between"
    >
      <!-- Logo -->
      <a href="/" class="flex flex-col justify-center gap-1.5 py-4">
        <img src="/urbana-white-logo.svg" alt="Urbana Hotel" class="h-6" />
        <span
          class="hidden md:block font-logo text-[11px] tracking-[0.55em] text-white/90 text-center pl-[0.55em]"
        >
          CITY HOTEL
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="hidden md:flex items-center gap-8 lg:gap-14 md:ml-auto">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "font-headline text-sm tracking-[0.12em] transition-colors",
                  currentPage === link.id
                    ? "text-white border-b border-white/80 pb-1"
                    : "text-white/85 hover:text-white",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Book Now Button (desktop) -->
      <a
        href="/book"
        class="hidden lg:flex self-stretch items-center justify-center -mr-4 ml-10 xl:ml-16 px-12 bg-light-gray text-text-primary hover:bg-white font-body text-sm tracking-[0.12em] transition-colors"
      >
        BOOK NOW
      </a>
    </div>
  </nav>
</header>

<!-- Mobile Bottom Nav -->
<nav
  class="md:hidden fixed bottom-3 inset-x-3 z-40 bg-white rounded-2xl shadow-[0_4px_24px_rgba(0,0,0,0.12)] flex items-stretch justify-between p-2 gap-1"
  aria-label="Mobile navigation"
>
  {
    navLinks.map((link) => {
      const active = currentPage === link.id;
      return (
        <a
          href={link.href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "flex-1 flex flex-col items-center justify-center gap-1 py-2 relative transition-colors",
            active ? "text-sky-blue" : "text-text-primary",
          ]}
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            set:html={link.icon}
          />
          <span class="font-body text-[10px] font-semibold tracking-wider">
            {link.label}
          </span>
          {active && (
            <span class="absolute bottom-0.5 w-1 h-1 rounded-full bg-sky-blue" />
          )}
        </a>
      );
    })
  }
  <a
    href="/book"
    class="bg-sky-blue hover:bg-sky-blue-light text-white font-body font-semibold text-[11px] tracking-wider px-4 rounded-xl flex items-center justify-center text-center leading-tight transition-colors min-w-16"
  >
    BOOK<br />NOW
  </a>
</nav>
