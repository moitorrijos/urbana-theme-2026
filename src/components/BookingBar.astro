---

---

<section class="relative z-20 -mt-14 lg:-mt-20">
  <div class="container mx-auto px-4">
    <!-- Five columns only fit from lg up (native date inputs have a wide
         intrinsic minimum), so md drops to a 2x2 grid and mobile stacks. -->
    <form
      class="bg-white shadow-[0_10px_40px_rgba(0,0,0,0.10)] grid grid-cols-1 md:grid-cols-2 md:gap-px md:bg-border-gray lg:flex lg:gap-0 lg:bg-white lg:items-stretch"
    >
      <!-- Check In -->
      <div
        class="bg-white flex-1 px-6 py-5 lg:py-8 border-b md:border-b-0 lg:border-r border-border-gray"
      >
        <label
          for="check-in"
          class="block font-body text-[11px] font-bold tracking-[0.18em] uppercase text-text-primary"
        >
          Check In
        </label>
        <input
          type="date"
          id="check-in"
          name="check-in"
          class="mt-2 w-full bg-transparent font-body text-sm text-medium-gray focus:outline-none"
        />
      </div>

      <!-- Check Out -->
      <div
        class="bg-white flex-1 px-6 py-5 lg:py-8 border-b md:border-b-0 lg:border-r border-border-gray"
      >
        <label
          for="check-out"
          class="block font-body text-[11px] font-bold tracking-[0.18em] uppercase text-text-primary"
        >
          Check Out
        </label>
        <input
          type="date"
          id="check-out"
          name="check-out"
          class="mt-2 w-full bg-transparent font-body text-sm text-medium-gray focus:outline-none"
        />
      </div>

      <!-- Adults -->
      <div
        class="bg-white flex-1 px-6 py-5 lg:py-8 border-b md:border-b-0 lg:border-r border-border-gray"
      >
        <label
          for="adults"
          class="block font-body text-[11px] font-bold tracking-[0.18em] uppercase text-text-primary"
        >
          Adults
        </label>
        <select
          id="adults"
          name="adults"
          class="mt-2 w-full bg-transparent font-body text-sm text-medium-gray focus:outline-none"
        >
          <option value="1">1 Adult</option>
          <option value="2" selected>2 Adults</option>
          <option value="3">3 Adults</option>
          <option value="4">4 Adults</option>
          <option value="5">5+ Adults</option>
        </select>
      </div>

      <!-- Children -->
      <div class="bg-white flex-1 px-6 py-5 lg:py-8">
        <label
          for="children"
          class="block font-body text-[11px] font-bold tracking-[0.18em] uppercase text-text-primary"
        >
          Children
        </label>
        <select
          id="children"
          name="children"
          class="mt-2 w-full bg-transparent font-body text-sm text-medium-gray focus:outline-none"
        >
          <option value="0" selected>No children</option>
          <option value="1">1 Child</option>
          <option value="2">2 Children</option>
          <option value="3">3+ Children</option>
        </select>
      </div>

      <!-- Submit -->
      <button
        type="submit"
        class="bg-top-bar hover:bg-sky-blue text-white font-body font-semibold text-sm tracking-[0.12em] uppercase md:col-span-2 lg:col-auto px-6 lg:px-12 py-5 lg:py-0 transition-colors"
      >
        Check Availability
      </button>
    </form>
  </div>
</section>
